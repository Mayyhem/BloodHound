+
+// Counting shortcuts must not invent an upper bound for an unrestricted path.
+func TestAggregateTraversalCountRequiresExplicitDepth(t *testing.T) {
+	t.Parallel()
+	regularQuery, err := frontend.ParseCypher(frontend.NewContext(), `
+        MATCH (u:User) WHERE u.hasspn = true
+        MATCH (u)-[:MemberOf|AdminTo*1..]->(c:Computer)
+        WITH DISTINCT u, count(c) AS total
+        RETURN u ORDER BY total DESC LIMIT 100
+    `)
+	require.NoError(t, err)
+	plan, err := Optimize(regularQuery)
+	require.NoError(t, err)
+	require.NotContains(t, plan.LoweringPlan.Decisions(), LoweringDecision{Name: LoweringAggregateTraversalCount})
+}
