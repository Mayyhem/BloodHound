+			parsed, err := frontend.ParseCypher(frontend.NewContext(), source)
+			require.NoError(t, err)
+			translated, err := TranslateWithOptions(ctx, parsed, optimizerSafetyKindMapper(), nil, DefaultGraphID, Options{OptimizerMode: mode})
+			require.NoError(t, err)
+			formatted, err := Translated(translated)
+			require.NoError(t, err)
+			// The first MATCH reads the target once. Reading its table again
+			// without using that new row multiplies both counts and work.
+			require.Equal(t, 1, strings.Count(formatted.Statement, "node n0"), formatted.Statement)
+		})
+	}
+}
