# Copy to postprocessor.env and use --env-file postprocessor.env with Compose.
# This runner joins an existing BloodHound/Neo4j network. It does not configure
# or create those services. Confirm the container names and network below.
BH_CONTAINER=esc1-poc-bloodhound-1
NEO4J_CONTAINER=esc1-poc-graph-db-1
BH_DOCKER_NETWORK=esc1-poc_default
BH_INTERNAL_PORT=8080
NEO4J_INTERNAL_PORT=7687

# The build script fills these local permission settings when it first creates
# postprocessor.env. If preparing it manually, use id -u, id -g, and
# stat -c %g /var/run/docker.sock on the Docker host.
POSTPROCESSOR_UID=1000
POSTPROCESSOR_GID=1000
DOCKER_SOCKET_GID=0

# Plan works without credentials. Commands that access BloodHound or Neo4j need
# credentials for the existing services; no real password is supplied here.
BH_TOKEN=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

POSTPROCESSOR_IMAGE=esc1-poc-postprocessor:local
EXTENSION_DIR=./extension
# To use the vault example, set EXTENSION_DIR=./examples/vault/extension.
COLLECTION_DIR=./testdata/baseline
POSTPROCESSOR_STATE_DIR=./work

# The mounted Docker socket grants control over Docker on this host, including
# starting and stopping containers. The runner needs this to stop/start the
# selected BloodHound container while processing. Use it only with a trusted
# executable and extension. Files are mounted at runtime, never baked into the image.
# Example (from this directory):
# ./scripts/build-container.sh
# docker compose --env-file postprocessor.env -f compose.postprocessor.yaml run --rm --no-deps postprocessor plan -extension /extension

# Select pg for a PostgreSQL BloodHound graph. It shares the application's DB.
GRAPH_DRIVER=neo4j
POSTGRES_CONTAINER=esc1-poc-pg-db-1
POSTGRES_INTERNAL_PORT=5432
POSTGRES_USER=bloodhound
POSTGRES_PASSWORD=
