# Retain the pinned runtime, collectors, and configuration. Replace its executable
# with the local extension-enabled API and embedded UI, leaving controls intact.
FROM esc1-poc-bloodhound:2cb6dbd37738ffe31e34e1729b3638f3887a93e9
COPY --chmod=0555 bloodhound /bloodhound
LABEL org.opencontainers.image.description="Local BloodHound with persistent post-processing rules"
