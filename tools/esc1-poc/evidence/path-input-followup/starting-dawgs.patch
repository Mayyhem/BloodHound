+func TestReusedEndObjectDoesNotReadAnUnrelatedNodeTable(t *testing.T) {
+	for _, mode := range []OptimizerMode{OptimizerEnabled, OptimizerDisabled} {
+		t.Run(string(mode), func(t *testing.T) {
+			var (
+				ctx    = context.Background()
