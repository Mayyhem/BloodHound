# Source this file for host commands using -compose compose.pg.yaml.
GRAPH_DRIVER=pg
POSTGRES_URI=postgresql://127.0.0.1:15432/bloodhound
POSTGRES_USER=bloodhound
POSTGRES_PASSWORD=experiment-only
# PostgreSQL owns both app and graph data in an independent lab directory.
POC_PG_DATA_DIR=./work/pg-reference-lab
# Tests use another database and storage, never the application database.
ESC1_POC_POSTGRES_TEST_URI=postgresql://127.0.0.1:25432/esc1_poc_test
