# The build script creates rules.env privately and fills a random token once.
# Never commit rules.env or print its token in logs.
POSTPROCESSOR_RULE_TOKEN=
POSTPROCESSOR_UID=1000
POSTPROCESSOR_GID=1000
POSTPROCESSOR_IMAGE=esc1-poc-postprocessor:local
EXTENSIONS_IMAGE=esc1-poc-bloodhound-extensions:local
BH_DOCKER_NETWORK=esc1-poc_default
RULE_STATE_DIR=./work/rules

# Optional Run Analysis button: configure all three, or leave all three empty.
# Use the BloodHound address reachable from the rule container, for example
# http://bloodhound:8080 on its Compose network. Create the token in BloodHound.
# The token's user must be allowed to run analysis and read the graph.
BLOODHOUND_API_URL=
BLOODHOUND_API_TOKEN_ID=
BLOODHOUND_API_TOKEN_KEY=
